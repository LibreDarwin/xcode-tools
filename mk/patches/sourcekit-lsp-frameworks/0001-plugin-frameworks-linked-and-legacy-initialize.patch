new file mode 100644
index 0000000..4e80878
--- /dev/null
+++ b/Sources/SwiftSourceKitPluginLinked/include/SwiftSourceKitPluginLinked.h
@@ -0,0 +1,19 @@
+//===----------------------------------------------------------------------===//
+//
+// SwiftSourceKitPluginLinked: the sourcekitd function tables, filled from the
+// functions sourcekitdInProc exports, for the SwiftSourceKitPlugin.framework
+// build that links sourcekitdInProc rather than loading it at run time.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef SWIFTSOURCEKITPLUGINLINKED_H
+#define SWIFTSOURCEKITPLUGINLINKED_H
+
+/// Fills the four tables -- sourcekitd_api_functions_t,
+/// sourcekitd_ide_api_functions_t, sourcekitd_plugin_api_functions_t and
+/// sourcekitd_service_plugin_api_functions_t, in that order -- with the
+/// functions sourcekitdInProc exports for them.  The tables are passed
+/// untyped so this header does not declare Csourcekitd's types a second time.
+void swiftsourcekitplugin_linked_functions(void *api, void *ide, void *plugin, void *service);
+
+#endif
