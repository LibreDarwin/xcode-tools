+/// The sourcekitd this plugin was loaded beside: the `sourcekitd.framework` next to the framework containing the
+/// plugin, or, if there is none, whatever the process has already loaded.
+private func sourcekitdRelativeToPlugin() -> SourceKitD {
+  var dlInfo = Dl_info()
+  dladdr(#dsohandle, &dlInfo)
+  let path = String(cString: dlInfo.dli_fname)
+  var url = URL(fileURLWithPath: path, isDirectory: false)
+  while url.pathExtension != "framework" && url.lastPathComponent != "/" {
+    url.deleteLastPathComponent()
+  }
+  url =
+    url
+    .deletingLastPathComponent()
+    .appendingPathComponent("sourcekitd.framework")
+    .appendingPathComponent("sourcekitd")
 
